+export function isEphemeralStatusMessage(rawContent: string): boolean {
+  // メンションを除いた実質本文で判定する (メンションのみの投稿は「空」扱い)
+  const text = (rawContent ?? '')
+    .replace(/<@[!&]?\d+>/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
