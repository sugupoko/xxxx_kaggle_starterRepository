+/**
+ * discord.js の MessageMentions#has と同じ判定をする最小スタブ。
+ * - users: 本文メンション + 返信先ユーザー (replied_user)
+ * - parsedUsers: 本文を解析した結果 (= 本文に実際に書かれたメンションのみ)
+ *   `ignoreRepliedUser: true` のときは parsedUsers 側だけを見る。
+ * - everyone: `@everyone` / `@here`。本家は `ignoreEveryone` が false なら
+ *   直接メンションを見る前に true を返す (MessageMentions.js の順序に合わせる)。
+ */
+const mentions = (input: { body?: string[]; repliedUser?: string; everyone?: boolean }) => {
+  const parsed = new Set(input.body ?? []);
+  const all = new Set([...parsed, ...(input.repliedUser ? [input.repliedUser] : [])]);
+  const everyone = input.everyone ?? false;
+  return {
+    everyone,
+    has: (user: unknown, options?: { ignoreRepliedUser?: boolean; ignoreEveryone?: boolean }) => {
+      if (!options?.ignoreEveryone && everyone) return true;
+      const id = String(user);
+      if (!all.has(id)) return false;
+      return options?.ignoreRepliedUser ? parsed.has(id) : true;
+    },
+  };
+};
