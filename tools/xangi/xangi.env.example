# tools/xangi/ の設定ファイル雛形。
#
#   cp tools/xangi/xangi.env.example tools/xangi/xangi.env   # xangi.env は .gitignore 済み
#
# tools/xangi/*.sh は起動時に tools/xangi/xangi.env があれば読み込む（XANGI_ENV_FILE で別パスも可）。
# cron のプロンプトや setsid 起動に毎回 env を並べなくて済むようにするため。
#
# 書き方は `: "${VAR:=値}"` で揃える。**すでに環境変数で渡された値が勝つ**
# （例: Agent B のコンテナでだけ XANGI_ROOT を変えたいとき、起動コマンド側の指定が優先される）。
#
# 🔴 2 体の bot が**同じリポジトリを別コンテナから共有**している場合、このファイルも共有される。
#    bot ごとに違う値（XANGI_ROOT など）は、ここではなく各コンテナの起動コマンド側で渡すこと。

# --- 必須 -------------------------------------------------------------------
# xangi を clone / 起動しているディレクトリ（.env・dist/・bin/xangi-cmd・.xangi/schedules.json がある場所）
: "${XANGI_ROOT:=/path/to/xangi}"

# xangi-cmd の場所。省略時は $XANGI_ROOT/bin/xangi-cmd
# : "${XANGI_CMD:=/path/to/xangi/bin/xangi-cmd}"

# --- 通知先（Discord のチャンネル ID。開発者モードで「ID をコピー」） ---------------
# 定点観測 cron の生存監視（xangi_health_daemon.sh ①）
: "${HEALTH_CHANNEL:=<CHANNEL_ID>}"
# Claude 使用率のしきい値通知・ゲージ（xangi_health_daemon.sh ②）
: "${USAGE_CHANNEL:=<CHANNEL_ID>}"
# GPU アイドル通知（gpu_idle_watch.sh）。未設定なら DISCORD_CHANNEL を使う
# : "${GPU_IDLE_CHANNEL:=<CHANNEL_ID>}"
# 汎用の既定チャンネル
# : "${DISCORD_CHANNEL:=<CHANNEL_ID>}"
# コア側 tools/notify.sh（kaggle_submit_now.sh / kaggle_submit_watch.sh）と kaggle_elapsed_notify.sh の通知先。
# XANGI_CMD と NOTIFY_CHANNEL の**両方**が設定されているときだけ通知される
# : "${NOTIFY_CHANNEL:=<CHANNEL_ID>}"

# --- 任意 -------------------------------------------------------------------
# xangi_health_daemon.sh の機能の ON/OFF（1=有効 / 0=無効）
# : "${ENABLE_CRON_CHECK:=1}"   # Kaggle 定点観測 cron の生存監視＋バックストップ
# : "${ENABLE_USAGE:=1}"        # Claude 使用率の監視
# Kaggle CLI / 認証が実行ユーザーの HOME の外にある環境だけ指定する
# : "${KAGGLE_CONFIG_DIR:=/path/to/.kaggle}"
# : "${KAGGLE_SITE_PACKAGES:=/path/to/site-packages}"
